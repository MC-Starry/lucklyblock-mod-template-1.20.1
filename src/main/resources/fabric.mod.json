{
	"schemaVersion": 1,
	"id": "luckblock",
	"version": "${version}",
	"name": "LucklyBlock-Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/luckblock/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fun.starry.LucklyBlockMod"
		],
		"client": [
			"fun.starry.client.LucklyBlockModClient"
		],
		"fabric-datagen": [
			"fun.starry.client.LucklyBlockModDataGenerator"
		]
	},
	"mixins": [
		"luckblock.mixins.json",
		{
			"config": "luckblock.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}